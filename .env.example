# Copy to .env.local and replace with real values. NEVER commit .env.local.
# All variables here are server-only: none are prefixed with NEXT_PUBLIC_,
# so none of them are ever shipped to the browser bundle.

# 32+ byte random string used to sign session JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Where the JSON demo datastore lives (MVP only; swap for a real DB later).
DATA_DIR=.data

# Optional: plug a real LLM in behind the AI engine interface (src/lib/ai).
# The app runs fully without these using the deterministic mock engine.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
